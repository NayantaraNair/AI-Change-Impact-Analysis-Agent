  "tests": [
    {
      "id": "DT-1",
      "title": "Enrolled customer completes web and mobile login with OTP",
      "category": "functional",
      "target": "POST /auth/login end-to-end login journey",
      "steps": [
        "Log in on the web client as an enrolled customer with email, password and verified mobile.",
        "Enter the OTP received by SMS and submit.",
        "Repeat the same journey on the mobile client with the same enrolled account.",
        "Call POST /auth/logout from each session."
      ],
      "expected": "Both clients reach the authenticated home view only after the correct OTP, the received code matches the one sent by SMS, and logout invalidates each session."
    },
    {
      "id": "DT-2",
      "title": "Password-only login returns an OTP challenge, valid OTP returns a session",
      "category": "api",
      "target": "POST /auth/login (auth-service)",
      "steps": [
        "Call POST /auth/login for an enrolled user with a verified mobile and the correct password.",
        "Inspect the response body and headers.",
        "Reuse the challenge identifier and POST /auth/login with a valid six-digit code before expiry.",
        "Inspect the returned payload."
      ],
      "expected": "First call returns an OTP-required challenge with no session token or refresh token; second call returns a TokenResponse with session credentials."
    },
    {
      "id": "DT-3",
      "title": "Five bad OTP codes lock the login for 30 minutes",
      "category": "unit",
      "target": "LoginAttemptTracker (services/auth-service/app/auth/lockout.py)",
      "steps": [
        "Instantiate LoginAttemptTracker with a fixed clock.",
        "Record five failed code verifications for one user in a row.",
        "Call the is_locked / can_attempt check immediately.",
        "Advance the clock 29 minutes and re-check.",
        "Advance to 30 minutes and re-check.",
        "Verify a code issued more than five minutes earlier is rejected as expired."
      ],
      "expected": "Tracker reports locked after the fifth failure, still locked at 29 minutes, unlocked at 30 minutes, and rejects OTPs older than five minutes."
    },
    {
      "id": "DT-4",
