{
  "story": {
    "id": "ST-115",
    "title": "Update the footer text on monthly statement PDFs",
    "description": "Update the monthly statement PDF footer text rendered by the document service to read: Thank you for banking with us. Apply the approved sentence to the English statement template and retain the existing font, alignment and page margins. The reporting service continues selecting the same template family and supplying the existing render payload. This is a presentation-only template update with fixed wording and a versioned layout asset. The existing rendering workflow remains unchanged. Publish a versioned template after preview approval; rollback consists of selecting the previous template version for subsequent statement rendering.",
    "type": "story",
    "acceptance_criteria": [
      "Every page of newly rendered English monthly statement PDFs shows exactly: Thank you for banking with us.",
      "Footer font, alignment, margins, page numbering and all other template content remain unchanged, including multi-page statements.",
      "document-service and reporting-service use the existing render payload and template selection interfaces without modification.",
      "An approved PDF preview confirms the footer fits the existing layout, and selecting the previous template version restores the prior footer."
    ]
  },
  "requirement": {
    "business_summary": "The footer text on English monthly statement PDFs is being changed to read \"Thank you for banking with us.\" The update is presentation-only and applies to newly rendered statements; the approved sentence replaces the previous footer while font, alignment, margins, page numbering and all other template content stay the same. A versioned template is published after preview approval, and rollback is performed by selecting the previous template version.",
    "technical_summary": "Update the versioned English monthly statement template layout asset in document-service so the footer renders the fixed sentence \"Thank you for banking with us.\" The existing rendering workflow, render payload interface and template selection interface are unchanged; reporting-service continues to select the same template family and supply the existing render payload. Publish a new template version after an approved PDF preview confirms the footer fits the layout; rollback selects the previous template version for subsequent statement rendering.",
    "business_domain": "Retail Banking — Customer Statements and Communications",
    "affected_capabilities": [
      "Monthly statement PDF rendering",
      "Statement template and layout asset management",
      "Statement template versioning and rollback"
    ],
    "affected_services": [
      "document-service"
    ],
    "change_type": "config_change",
    "touches_customer_data": false,
    "touches_card_data": false,
    "touches_financial_data": false,
    "changes_auth_flow": false,
    "changes_external_api_contract": false,
    "changes_db_schema": false,
    "ambiguity": "low",
    "engineering_scope": "Small, contained change in a single service: replace fixed footer text in the versioned English monthly statement template asset in document-service and publish a new template version after preview approval. No code-path, payload, template-selection, API or schema changes; reporting-service and all other services remain untouched. Rollback is template-version selection only.",
    "source": "tokenharbor:deepseek-v4.1-flash:free"
  },
