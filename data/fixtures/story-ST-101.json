{
  "story": {
    "id": "ST-101",
    "title": "Increase daily payment limits for premium customers",
    "description": "Increase daily payment limits for premium customers from AED 25,000 to AED 50,000 for domestic transfers. The payment-service must obtain premium eligibility and the effective account limit from account-service before accepting each payment. Keep fraud screening active through fraud-engine and use the transaction ledger in transaction-db to calculate the remaining daily allowance, including concurrent requests. Roll out the business rule behind an approved feature flag during the payments release window. Operations must confirm threshold monitoring and rollback readiness before enabling the higher limit; standard customer limits remain unchanged.",
    "type": "story",
    "acceptance_criteria": [
      "A premium account can submit domestic payments totaling AED 50,000 per bank-local calendar day; the next payment is declined.",
      "A standard account retains its AED 25,000 daily limit and existing per-payment checks.",
      "Concurrent payment submissions cannot exceed the account daily limit, and retries create one transaction ledger posting.",
      "Every accepted payment passes fraud screening; operations approves monitoring and can restore the previous limit with the feature flag."
    ]
  },
  "requirement": {
    "business_summary": "Increase the daily domestic payment limit for premium customers from AED 25,000 to AED 50,000, while keeping standard customer limits unchanged, and roll out the change via a feature flag.",
    "technical_summary": "Payment-service will call account-service to retrieve premium eligibility and the effective account limit before accepting a payment, then query transaction-db ledger to calculate the remaining daily allowance (including concurrent requests), enforce the new limit, and continue to route payments through fraud-engine for screening; the higher limit is enabled behind an approved feature flag during the payments release window.",
    "business_domain": "Payments",
    "affected_capabilities": [
      "Domestic payment processing",
      "Premium eligibility check",
      "Daily limit enforcement",
      "Fraud screening",
      "Feature flag toggling"
    ],
    "affected_services": [
      "payment-service",
      "account-service"
    ],
    "change_type": "business_rule_change",
    "touches_customer_data": true,
    "touches_card_data": false,
    "touches_financial_data": true,
    "changes_auth_flow": false,
    "changes_external_api_contract": false,
    "changes_db_schema": false,
    "ambiguity": "low",
    "engineering_scope": "A small, contained change: payment-service modified to fetch premium eligibility and limit from account-service, compute remaining allowance using transaction-db reads, enforce the new limit via a feature flag; account-service updated to expose premium eligibility/effective limit; feature flag configuration added.",
