                       ],
        "upstream":  [
                         "crm",
                         "customer-service",
                         "payment-service"
                     ],
        "apis":  [
                     {
                         "id":  "notification-service.send",
                         "method":  "POST",
                         "path":  "/notifications",
                         "description":  "Queue a notification to a verified destination",
                         "external":  false
                     },
                     {
                         "id":  "notification-service.status",
