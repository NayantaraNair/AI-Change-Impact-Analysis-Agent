    {
        "id":  "notification-service",
        "name":  "Notification Service",
        "type":  "platform",
        "description":  "Delivers consent-aware email, SMS and push notifications using verified customer destinations.",
        "owner_team":  "Customer Platform",
        "owner_contact":  "customer-platform@bank.example",
        "criticality":  6,
        "data_classes":  [
                             "pii"
                         ],
